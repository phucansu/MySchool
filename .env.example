# ==========================================================
# MySchool - Environment variables template
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# ==========================================================

# ----- Runtime -----
# "production" on Vercel; leave unset or "development" for local
NODE_ENV=development
PORT=5000

# ----- Database (Neon PostgreSQL) -----
# Production / cloud: single connection string (preferred)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Local development alternative (used only when DATABASE_URL is empty)
DB_USER=postgres
DB_PASSWORD=your_local_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myschool

# ----- Security secrets (REQUIRED - server will not start without these) -----
# Generate strong random values, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ADMIN_SECRET=

# ----- AI (Google Gemini) -----
# The ONLY source for the Gemini key. There is no admin UI to store it.
GEMINI_API_KEY=

# ----- Google OAuth (Sign in with Google) -----
GOOGLE_CLIENT_ID=

# ----- CORS -----
# Comma-separated list of allowed origins in production.
# Example: https://myschool.vercel.app,https://www.your-domain.com
ALLOWED_ORIGINS=

# ----- Email (Resend) - for password reset -----
# If these are not set, the password-reset endpoint reports "not configured"
# instead of falling back to an insecure reset.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional: password-reset token lifetime in minutes (default 30)
RESET_TOKEN_TTL_MINUTES=30

# ----- Rate limiting (optional; defaults shown; only enforced when NODE_ENV=production) -----
# Auth limits are per IP over a 15-minute window.
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_RESET=5
# AI limits are per authenticated user over RATE_LIMIT_AI_WINDOW_MIN minutes.
RATE_LIMIT_AI=20
RATE_LIMIT_AI_WINDOW_MIN=10
